{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "Configures the JX11 plugin using the Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "/Library/Developer/CommandLineTools/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/Library/Developer/CommandLineTools/usr/bin/clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-debug",
      "displayName": "Build with Ninja",
      "configurePreset": "ninja-debug"
    }
  ]
}
