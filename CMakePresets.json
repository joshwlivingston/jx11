{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "Configures the JX11 plugin using the Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "vs-debug",
      "displayName": "Visual Studio Debug",
      "description": "Configures the JX11 plugin using the Visual Studio 2022 generator",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vs"
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-debug",
      "displayName": "Build with Ninja",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "vs-debug",
      "displayName": "Build with Visual Studio",
      "configurePreset": "vs-debug",
      "configuration": "Debug"
    }
  ]
}
